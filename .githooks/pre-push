#!/usr/bin/env bash
set -euo pipefail

current_branch="$(git rev-parse --abbrev-ref HEAD)"
target_branch="claude/sync-mobile-apps-latest"

if [[ "$current_branch" != "$target_branch" ]]; then
  exit 0
fi

echo "[pre-push] Deploying '$current_branch' to Vercel production..."
npx vercel --prod --yes
echo "[pre-push] Production deployment finished. Continuing with git push."
